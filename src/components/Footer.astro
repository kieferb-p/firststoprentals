---
---

<footer>
    <div class="bg-[var(--section-dark)] text-[var(--text)] py-12 border-t border-[var(--border)] pl-6">
        <div class="container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
            <div>
                <h3 class="text-[var(--text-h)] font-bold mb-4">First Stop Rentals</h3>
                <p class="leading-relaxed">
                    Kemptville, Ontario<br />
                    Serving Eastern Ontario since 1994<br />
                     <a href="tel:6132584152" class="hover:text-[var(--accent)] transition">613-258-4152</a>
                </p>
            </div>

            <div>
                <h3 class="text-[var(--text-h)] font-bold mb-4">Equipment</h3>
                <ul class="space-y-2">
                    <li><a href="/equipment" class="hover:text-[var(--accent)] transition">All Categories</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-[var(--text-h)] font-bold mb-4">Services</h3>
                <ul class="space-y-2">
                    <li><a href="/contact" class="hover:text-[var(--accent)] transition">Delivery</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-[var(--text-h)] font-bold mb-4">Hours</h3>
                <ul class="space-y-2">
                    <li>Mon-Fri: 7am - 5pm</li>
                    <li>Saturday: 8am - 4pm</li>
                    <li>Sunday: Closed</li>
                    <li>
                        <a
                        href="https://maps.app.goo.gl/KesBQtqkfExTa8Sh6"
                        target="_blank"
                        rel="noreferrer"
                        class="hover:text-[var(--accent)] transition"
                        >
                        Get Directions
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="bg-[var(--section-darker)] text-[var(--text)] py-6 border-t border-[var(--border)]">
        <div class="container flex flex-col sm:flex-row justify-between items-center gap-4">
            <p class="text-sm">&copy; {new Date().getFullYear()} First Stop Tool &amp; Equipment Rentals Ltd.</p>
            <div class="flex gap-6 text-sm">
                <a href="/privacy" class="hover:text-[var(--accent)] transition">Privacy Notice</a>
                <a href="/careers" class="hover:text-[var(--accent)] transition">Careers</a>
                <a href="/faq" class="hover:text-[var(--accent)] transition">Frequently Asked Questions (FAQ)</a>
            </div>
        </div>
    </div>
</footer>
