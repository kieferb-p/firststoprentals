---
const { title = 'Page', subtitle = '' } = Astro.props;
---

<div class="text-center py-10 bg-[var(--section-dark)] border-b-4 border-[var(--accent)] mb-10">
     <h4 class="text-[var(--accent)] uppercase tracking-[3px] text-sm font-bold mb-3">First Stop Rentals</h4>
     <h1 class="text-4xl md:text-5xl font-medium text-[var(--text-h)] uppercase tracking-tight">{title}</h1>
     {subtitle && <p class="text-[var(--text)] mt-4 text-lg">{subtitle}</p>}
</div>
