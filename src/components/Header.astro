---
import type { AstroProps } from 'astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
   { label: 'Equipment', to: '/equipment' },
   { label: 'Rates', to: '/rental-rates' },
   { label: 'Deliveries', to: '/delivery' },
   { label: 'Shop', to: '/shop' },
   { label: 'FAQ', to: '/faq' },
   { label: 'About', to: '/about' },
];

const isEquipment = currentPath.startsWith('/equipment');
---

<div class={`relative top-0 z-50 bg-[var(--bg)] opacity-98 ${!isEquipment ? 'sticky top-0' : ''}`}>
   <div class="bg-[var(--bg)] text-white text-center p-0 m-0 text-sm font-semibold">
     <a href="tel:6132584152" class="hover:opacity-90 transition">
       613-258-4152 | Call to book now!
     </a>
   </div>
   <header class="bg-[var(--bg)]">
     <div class="bg-[var(--bg)] py-4 border-b border-[var(--border)]">
       <div class="container flex justify-between items-center">
         <a href="/" class="flex items-center gap-4">
           <img
             src="/fsr_sign.png"
             alt="First Stop Rentals Logo"
             class="h-10 md:h-20 w-auto"
           />
           <div class="text-white">
             <div class="text-xl font-bold leading-tight">First Stop Tool &amp; Equipment Rentals Ltd.</div>
             <div class="text-xs text-gray-100">Kemptville - Ottawa - Smiths Falls area</div>
           </div>
         </a>

         <nav class="hidden xl:flex items-center gap-4">
           {navItems.map((item) => {
            const isActive = currentPath === item.to;
            return (
               <a
                href={item.to}
                class={`relative pb-1 text-sm font-medium transition after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-white after:transition-all ${isActive ? 'text-white after:opacity-100' : ' text-gray-100 hover:text-white after:opacity-0 hover:after:opacity-100'}`}
               >
                 {item.label}
               </a>
             );
           })}
           <a
            href="/contact"
            class="ml-4 border-2 border-white text-white px-5 py-2 rounded-full text-sm font-semibold hover:border-[var(--accent)] hover:text-[var(--accent)] transition"
           >
            Contact Us
           </a>
         </nav>

         <button
          id="mobile-menu-toggle"
          class="xl:hidden text-white p-2"
          aria-label="Toggle menu"
         >
           <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
             <line x1="3" y1="6" x2="21" y2="6" />
             <line x1="3" y1="12" x2="21" y2="12" />
             <line x1="3" y1="18" x2="21" y2="18" />
           </svg>
         </button>
       </div>
     </div>

     <div id="mobile-menu" class="lg:hidden fixed inset-0 top-0 z-50 bg-[var(--bg)]/99 hidden">
       <div class="container py-6 flex flex-col gap-4">
         <div class="flex justify-end mb-4">
           <button
            id="mobile-menu-close"
            class="text-white p-2"
            aria-label="Close menu"
           >
             <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
               <line x1="18" y1="6" x2="6" y2="18" />
               <line x1="6" y1="6" x2="18" y2="18" />
             </svg>
           </button>
         </div>
         {navItems.map((item) => (
           <a
            href={item.to}
            class="text-white text-lg font-medium py-2 px-6 hover:text-gray-100 transition mobile-nav-link"
           >
             {item.label}
           </a>
         ))}
         <div class="mt-4 w-full">
           <a
            href="/contact"
            class="block w-full text-center border-2 border-white text-white px-5 py-3 rounded-full text-sm font-semibold hover:border-[var(--accent)] hover:text-[var(--accent)] transition mobile-nav-link"
           >
            Contact Us
           </a>
         </div>
       </div>
     </div>
   </header>
</div>

<script is:inline>
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() { menu.classList.remove('hidden'); }
  function closeMenu() { menu.classList.add('hidden'); }

  toggle?.addEventListener('click', () => {
    menu.classList.toggle('hidden');
   });
  closeBtn?.addEventListener('click', closeMenu);
  navLinks.forEach(link => link.addEventListener('click', closeMenu));
</script>
