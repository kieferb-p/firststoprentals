  ---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';

const FAQ_DATA = [
     {
     category: '4-Stroke Engines',
     questions: [
        { question: 'How do I start a 4-stroke engine?', answer: 'Turn the ignition switch ON, turn the fuel on (black valve to the right), close the choke (grey valve to the left), and set the throttle halfway. Pull the cord quickly with a maximum 2-foot pull. Once started, open the choke and let it idle for 1-2 minutes.' },
        { question: 'Can I run a 4-stroke engine below full throttle?', answer: 'Engines are designed to run at full throttle only. Running at anything less will cause lugging, overheating, and clutch damage. At 3600 RPM the clutch springs are fully engaged; running at 1500-2000 RPM prevents full engagement, causing the clutch to slip and overheat, and the belt to melt.' },
        { question: 'How do I shut off a 4-stroke engine?', answer: 'Let it idle for a minute, turn the ignition off, and be sure to shut the fuel off.' },
        { question: 'Why does this machine only run for a couple of minutes then die?', answer: 'Check the following:<ul class="list-disc pl-5 mt-2 space-y-1"><li>Is the ignition switch on?</li><li>What position is the fuel valve in? (Left or Right?)</li><li>What position is the choke in?</li><li>What position is the throttle in?</li><li>Is the engine loaded down (belt engaged)?</li></ul>' },
      ],
    },
     {
     category: '2-Stroke Engines',
     questions: [
         { question: 'How do I start a 2-stroke engine?', answer: 'Turn the ignition switch on, push the decompression in, pull the choke out, lock the throttle, and pull to start. Once the engine fires, push the choke and decompression in, and pull one last time. Note: failing to follow any one of these steps will cause the engine to flood.' },
         { question: 'Why does my 2-stroke engine flood?', answer: 'All it takes is tipping it on its side to refuel, or sometimes just leaving it in the sun for 2 minutes. The heat expands the gas and pressurizes it, filling the engine. Another cause of flooding is pulling the cord too slowly.' },
         { question: 'How do I unflood a 2-stroke engine?', answer: 'One person must squeeze the trigger to full throttle while another pulls the engine over 15-20 times to clear it. Once the engine starts, run it at full throttle until the blue smoke has fully cleared.' },
      ],
    },
     {
     category: 'Compactors',
     questions: [
         { question: 'What size compactor do I need for my project?', answer: 'The appropriate size is determined by the thickness of the compaction layers, not the dimensions of the area. Use this guide:<ul class="list-disc pl-5 mt-2 space-y-1"><li>100 lb: 1&quot;&ndash;2&quot; layers</li><li>160 lb: 2&quot;&ndash;3&quot; layers</li><li>200 lb: 3&quot;&ndash;4&quot; layers</li><li>400 lb: 6&quot;&ndash;8&quot; layers</li><li>800 lb: 8&quot;&ndash;12&quot; layers</li><li>1,100 lb: 12&quot;&ndash;18&quot; layers</li><li>1,300 lb: 12&quot;&ndash;24&quot; layers</li></ul>' },
      ],
    },
     {
     category: 'Compressors',
     questions: [
         { question: 'Why won\'t my compressor shut off after plugging it in with the hose attached?', answer: 'The valves in the air nailer will not seal until enough pressure has built up. Disconnect the hose first, then reconnect once pressure is established.' },
      ],
    },
     {
     category: 'Jack Hammers & Chippers',
     questions: [
         { question: 'Which tool should I use - jackhammer or chipper?', answer: 'Use a chipper for walls. Use a jackhammer for floors.' },
         { question: 'Why are the bits dulling so quickly?', answer: 'Jackhammers and chippers must be used at a 30-degree angle only. Using them at a 90-degree angle will dull the bits almost immediately.' },
      ],
    },
     {
     category: 'Ceramic Tile / Target Saws',
     questions: [
         { question: 'The wet saw was cutting fine for about 15 minutes and then it stopped. The motor is warm too. Why?', answer: 'This means you\'ve been forcing the tool and it has overheated. Let the motor cool down completely, then press the reset button.' },
      ],
    },
     {
     category: 'Hardwood Nailers / Staplers',
     questions: [
         { question: 'Why are the nails/staples jamming in the gun?', answer: 'There are two possible reasons:<ol class="list-decimal pl-5 mt-2 space-y-1"><li>You\'re driving nails directly into the screws of the subfloor.</li><li>You\'re using the wrong gauge of staples or nails. Off-brand staples are often a finer gauge and will jam and cause damage in our staplers and nailers.</li></ol>' },
      ],
    },
     {
     category: 'Carpet Cleaner',
     questions: [
         { question: 'Why is there no soap spraying into the carpet?', answer: 'Check that the switches are in the correct position (carpet, floor, or upholstery). Then disconnect and reconnect the quick coupler to ensure a proper seal.' },
      ],
    },
     {
     category: 'Floor Sanders',
     questions: [
         { question: 'What type of floor sander do I need?', answer: 'For a freshly laid floor, an orbital sander is ideal. If you\'re removing heavy varnish or paint, or if your floors are uneven, you\'ll need a drum sander with an edger.' },
      ],
    },
     {
     category: 'Circuit Breakers',
     questions: [
         { question: 'Why are my circuit breakers tripping?', answer: 'There are three possible explanations:<ol class="list-decimal pl-5 mt-2 space-y-1"><li>You\'re using an extension cord, which is not advised and can severely damage the equipment.</li><li>You have both machines running on the same circuit.</li><li>There is faulty wiring in the house.</li></ol>' },
      ],
    },
     {
     category: 'Generators',
     questions: [
         { question: 'What size generator do I need?', answer: 'A good rule of thumb is 3x your load, because it takes 3x as much wattage to start equipment as it does to keep it running. For example, a 1500W electric chipper would need a 4500W generator just to start. Formula: Wattage = Voltage &times; Amperage' },
         { question: 'Can I run an air compressor on a generator?', answer: '<strong>Warning: an air compressor should never be run on a generator.</strong> When an air compressor starts, it draws approximately 40 amps for a split second. The generator cannot handle this spike and will keep the compressor running at a lower RPM on its start winding, burning out both the compressor and the generator.' },
      ],
    },
     {
     category: 'Heaters',
     questions: [
         { question: 'Are there any requirements to rent a heater?', answer: 'A certificate of training is mandatory for renting any propane heater.' },
      ],
    },
     {
     category: 'Brush Cutters',
     questions: [
         { question: 'What type of blade do I need?', answer: 'For tall grass, a triangle blade is recommended. For thick, woody brush up to 1 inch in diameter, the skill saw blade is recommended.' },
      ],
    },
     {
     category: 'Lawn Aerators',
     questions: [
         { question: 'The belt came off, what do I do?', answer: 'This typically happens when running the machine lengthwise along a ditch at an angle. If possible, try running it up and down across the ditch instead.' },
         { question: 'Which should I use first - aerator, dethatcher, or lawn comb?', answer: 'Dethatch first, then aerate.' },
      ],
    },
     {
     category: 'Lawn Mower',
     questions: [
         { question: 'How tall can my grass be to use a lawn mower?', answer: 'Grass up to 6-8 inches tall can be cut with a lawn mower, but cut at only half the mower\'s width to reduce stalling. For grass any taller than that, you\'ll need a brush cutter with a triangle blade.' },
      ],
    },
     {
     category: 'Log Splitter',
     questions: [
         { question: 'Why won\'t the engine start?', answer: 'The log splitter may be under load. Put the lever in neutral and it should start.' },
      ],
    },
     {
     category: 'Post Hole Augers',
     questions: [
         { question: 'What type of auger will I need?', answer: 'We have four types, depending on how many holes you need:<ol class="list-decimal pl-5 mt-2 space-y-2"><li><strong>Manual auger:</strong> best for just a few holes.</li><li><strong>2-Man auger:</strong> suitable for up to 10 holes, though the torque can be difficult to manage when hitting rocks or roots. Both operators should feel confident handling the machine.</li><li><strong>1-Man hydraulic auger:</strong> best for 10-20 holes with less physical effort than the manual or 2-man options.</li><li><strong>MT52 auger attachment:</strong> best for 20+ holes. The easiest option for getting the job done quickly with minimal labour.</li></ol>' },
      ],
    },
     {
     category: 'Sod Cutter',
     questions: [
         { question: 'Are there any procedures I need to take prior to renting?', answer: 'Soak your lawn thoroughly beforehand. Dry ground makes it hard for the blade to cut through the sod and can damage the machine. If you hit a rock or root, stop and investigate before continuing to avoid further damage.' },
      ],
    },
     {
     category: 'Stump Grinder',
     questions: [
         { question: 'Are there any procedures I need to take prior to renting?', answer: 'Dig 6 inches around your stumps and hose down the dirt the night before. The stump grinder works like a chainsaw; you never want to cut through dirt with either machine.' },
      ],
    },
     {
     category: 'Tillers (Rotto)',
     questions: [
         { question: 'What type of tiller do I need?', answer: 'We have three types:<ol class="list-decimal pl-5 mt-2 space-y-1"><li><strong>Mini-Tyne Tiller:</strong> for raised garden beds.</li><li><strong>Front-Tyne Tiller:</strong> for existing gardens that just need to be turned over for the season.</li><li><strong>Mid-Tyne Tiller:</strong> for creating new gardens.</li></ol>' },
      ],
    },
     {
     category: 'Trencher',
     questions: [
         { question: 'What do I do if the belt starts to squeal?', answer: 'Stop immediately and shut the engine off. A rock is likely jammed in the chain. Remove the rock or root from the chain before proceeding.' },
      ],
    },
     {
     category: 'Plumbing',
     questions: [
         { question: 'Why must I unplug the pipe thawer before pressurizing?', answer: 'When the water comes through, the heating element becomes exposed and will burn out. Always unplug the pipe thawer before pressurizing.' },
      ],
    },
     {
     category: 'Pressure Washers',
     questions: [
         { question: 'Why can\'t I pull the engine over? After the 3rd pull it won\'t pull anymore.', answer: 'The engine is hydraulically locked. This happens when the trigger on the wand is not pulled to release the pressure. Pull the trigger to relieve pressure before starting the engine.' },
         { question: 'Why must I bleed the air out before turning it on?', answer: 'Skipping this step will overheat the pump and motor. Always bleed the air out before turning the machine on. This is a crucial step.' },
      ],
    },
     {
     category: 'Pumps',
     questions: [
         { question: 'Why must pumps be primed prior to use?', answer: 'Running a pump without priming it will cause the seals to overheat and burn out without water to cool them.' },
      ],
    },
     {
     category: 'Rental Rates & Delivery',
     questions: [
         { question: 'How are rental rates calculated?', answer: 'Our rates are calculated based on the duration of your rental. See our <a href="/rental-rates" class="text-[var(--text-h)] underline">rental rates page</a> for full details including hourly, overnight, and weekend specials.' },
         { question: 'What are the delivery rates?', answer: 'Small equipment delivery starts at $60 up to 15 km, and large equipment or scaffold delivery starts at $85. Both charge $1.60 per extra km. See our <a href="/delivery" class="text-[var(--text-h)] underline">delivery page</a> for approximate rates to nearby towns.' },
         { question: 'What days and times do you deliver?', answer: 'Deliveries are available Monday through Friday, 8:00 am to 5:00 pm.' },
         { question: 'Are there hourly rental options?', answer: 'Yes! Most items are available for 3-hour (55% of day rate), 4-hour (65%), or 5-hour (75%) rentals during business hours. Rentals over 5 hours are billed as a full day. See our <a href="/rental-rates" class="text-[var(--text-h)] underline">rates page</a> for more details.' },
         { question: 'What does an overnight rental cost?', answer: 'Pick up at 4:00 pm Monday through Thursday and return by 9:00 am the next morning, billed at the 5-hour rate (75% of day rate). Overnight rentals do not count toward monthly discounts. See our <a href="/rental-rates" class="text-[var(--text-h)] underline">rates page</a> for more details.' },
      ],
    },
];

const totalAnswerCount = FAQ_DATA.reduce((sum, cat) => sum + cat.questions.length, 0);
---

<Layout>
      <div class="bg-[var(--bg)]">
          <PageBanner title="Frequently Asked Questions" subtitle="Finding quick answers to keep your projects moving." />

       <div class="container mx-auto max-w-6xl py-10">

          <div class="max-w-2xl mx-auto mb-10">
             <div class="bg-[var(--section-dark)] rounded-[10px] p-5 border border-[var(--border)]">
                <label htmlFor="faq-search" class="block text-sm text-[var(--text)] mb-2">Search FAQ</label>
               <input
               id="faq-search"
               type="text"
               class="w-full p-3 bg-[var(--section-medium)] border border-[var(--border)] rounded-[10px] text-[var(--text)] placeholder-gray-500 focus:border-[var(--text-h)] focus:outline-none transition"
               placeholder={`Search ${totalAnswerCount}+ answers...`}
               />
               <div id="faq-search-results" class="mt-3 text-sm text-[var(--text)] hidden"></div>
             </div>
           </div>

           <div class="max-w-3xl mx-auto" id="faq-categories">
              {FAQ_DATA.map((category, catIndex) => {
             return (
                 <div class="mb-4" data-category={catIndex}>
                    <button
                    class="faq-category-toggle w-full flex justify-between items-center p-4 bg-[var(--section-medium)] border border-[var(--border)] rounded-[10px] text-left"
                    data-cat-idx={catIndex}
                    >
                      <div class="flex items-center gap-3">
                        <span class="text-[var(--text-h)] font-bold text-lg uppercase tracking-wide">{category.category}</span>
                        <span class="text-[var(--text)] text-xs">{category.questions.length} question{category.questions.length !== 1 ? 's' : ''}</span>
                        </div>
                        <span class="text-[var(--text-h)] text-2xl shrink-0 faq-toggle-icon">+</span>
                    </button>
                    <div class="faq-category-content overflow-hidden transition-all duration-300 hidden">
                      <div class="mt-2">
                        <div class="mb-8">
                          <h2 class="font-bold uppercase tracking-wide mb-4 border-b border-[var(--border)] pb-2">{category.category}</h2>
                          <div class="space-y-2">
                            {category.questions.map((faq, qIndex) => {
                            return (
                              <div class="border border-[var(--border)] rounded-[10px] bg-[var(--section-medium)] overflow-hidden">
                                <button
                                class="faq-question-toggle w-full flex justify-between items-center p-4 text-left hover:bg-[var(--section-dark)] transition"
                                data-q-idx={qIndex}
                                >
                                  <span class="text-[var(--text-h)] font-medium pr-4">{faq.question}</span>
                                  <span class="text-[var(--text-h)] text-2xl shrink-0 faq-q-icon">+</span>
                                </button>
                                <div class="faq-question-content overflow-hidden transition-all duration-300 hidden">
                                  <div class="px-4 pb-4 text-[var(--text)] border-t border-[var(--border)] pt-6" set:html={faq.answer}></div>
                                </div>
                              </div>
                             );
                             })}
                          </div>
                        </div>
                      </div>
                    </div>
                 </div>
               );
             })}
           </div>
         </div>
       </div>
</Layout>

<script is:inline>
   (function() {
    var toggleBtns = document.querySelectorAll('.faq-category-toggle');
    var qBtns = document.querySelectorAll('.faq-question-toggle');
    var searchInput = document.getElementById('faq-search');
    var resultsEl = document.getElementById('faq-search-results');

    toggleBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var content = btn.nextElementSibling;
        var icon = btn.querySelector('.faq-toggle-icon');
        if (content.classList.contains('hidden')) {
          content.classList.remove('hidden');
          icon.textContent = '−';
         } else {
           content.classList.add('hidden');
           icon.textContent = '+';
         }
        });
     });

    qBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var content = btn.nextElementSibling;
        var icon = btn.querySelector('.faq-q-icon');
        if (content.classList.contains('hidden')) {
          content.classList.remove('hidden');
          icon.textContent = '−';
         } else {
           content.classList.add('hidden');
           icon.textContent = '+';
         }
        });
     });

    if (searchInput && resultsEl) {
      searchInput.addEventListener('input', function() {
        var q = searchInput.value.toLowerCase().trim();
        var allCategories = document.querySelectorAll('#faq-categories > div');
        var totalMatches = 0;

        allCategories.forEach(function(catEl) {
           var qBtns = catEl.querySelectorAll('.faq-question-toggle');
           var catContent = catEl.querySelector('.faq-category-content');
           var catIcon = catEl.querySelector('.faq-toggle-icon');
           var hasVisible = false;

           qBtns.forEach(function(qBtn) {
             var qContent = qBtn.nextElementSibling;
             var qText = qBtn.querySelector('span').textContent.toLowerCase();
             var aText = qContent.textContent.toLowerCase();
             if (!q || qText.includes(q) || aText.includes(q)) {
               qContent.classList.remove('hidden');
               hasVisible = true;
               totalMatches++;
              } else {
               qContent.classList.add('hidden');
              }
            });

           if (q) {
             if (hasVisible) {
               catEl.classList.remove('hidden');
               if (catContent) { catContent.classList.remove('hidden'); }
               if (catIcon) catIcon.textContent = '−';
              } else {
               catEl.classList.add('hidden');
              }
            } else {
             catEl.classList.remove('hidden');
            }
         });

         if (q) {
           resultsEl.innerHTML = totalMatches + ' result' + (totalMatches !== 1 ? 's' : '') +
              ' <button id="faq-clear-search" class="ml-3 text-[var(--text)] hover:text-[var(--text-h)] transition">&#10005; Clear</button>';
           resultsEl.classList.remove('hidden');
           document.getElementById('faq-clear-search')?.addEventListener('click', function() {
             searchInput.value = '';
             searchInput.dispatchEvent(new Event('input'));
            });
          } else {
           resultsEl.classList.add('hidden');
          }
        });
     }
    })();
</script>
